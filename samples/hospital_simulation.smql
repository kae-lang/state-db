-- ============================================================================
-- Hospital System Simulation — SMQL
-- ============================================================================
-- A comprehensive hospital simulation demonstrating 10 state machines,
-- 4 real-world clinical scenarios, ~43 spawned instances, and analytics.
--
-- Run: cd smql-engine && cargo build --release -p smql-cli
--      ./target/release/smql run ../samples/hospital_simulation.smql --storage memory
-- ============================================================================


-- ============================================================================
-- MACHINE 1: Patient
-- Tracks a patient through their hospital journey.
-- ============================================================================
DEFINE MACHINE Patient (
  DATA {
    name              : TEXT -> REQUIRED
    date_of_birth     : TEXT -> REQUIRED
    gender            : ENUM(male, female, other) -> REQUIRED
    blood_type        : ENUM(A_pos, A_neg, B_pos, B_neg, AB_pos, AB_neg, O_pos, O_neg) -> OPTIONAL
    insurance_id      : TEXT -> OPTIONAL
    allergies         : TEXT -> OPTIONAL
    assigned_doctor   : TEXT -> OPTIONAL
    assigned_nurse    : TEXT -> OPTIONAL
    assigned_bed      : TEXT -> OPTIONAL
    primary_diagnosis : TEXT -> OPTIONAL
    admission_type    : ENUM(emergency, elective, outpatient) -> OPTIONAL
    notes             : TEXT -> OPTIONAL
  }

  STATES {
    registered
    triaged
    admitted
    in_treatment
    in_surgery
    recovering
    ready_for_discharge
    discharged
    deceased
  }
  INITIAL STATE registered
  TERMINAL STATES { discharged, deceased }

  TRANSITIONS {
    registered -> triaged {
      GUARD : assigned_nurse IS SET
    }

    triaged -> admitted {
      GUARD : assigned_doctor IS SET
      GUARD : assigned_bed IS SET
    }

    triaged -> discharged {}

    admitted -> in_treatment {
      GUARD : primary_diagnosis IS SET
    }

    in_treatment -> in_surgery {}

    in_treatment -> recovering {}

    in_surgery -> recovering {}

    recovering -> ready_for_discharge {}

    ready_for_discharge -> discharged {}

    ANY -> deceased {
      EXCEPT FROM { discharged, deceased }
    }
  }

  HOOKS {
    ON SPAWN {
      EMIT("patient.registered")
    }
    ON ENTER admitted {
      EMIT("patient.admitted")
    }
    ON ENTER discharged {
      EMIT("patient.discharged")
    }
  }
)


-- ============================================================================
-- MACHINE 2: Doctor
-- Cyclic machine — doctors rotate through availability states.
-- ============================================================================
DEFINE MACHINE Doctor (
  DATA {
    name            : TEXT -> REQUIRED
    specialty       : ENUM(cardiology, emergency, general, orthopedics, anesthesiology, radiology) -> REQUIRED
    license_number  : TEXT -> REQUIRED
    current_patient : TEXT -> OPTIONAL
  }

  STATES { off_duty, available, in_consultation, in_surgery, on_break }
  INITIAL STATE off_duty

  TRANSITIONS {
    off_duty -> available {}

    available -> in_consultation {
      GUARD : current_patient IS SET
    }

    available -> in_surgery {
      GUARD : current_patient IS SET
    }

    available -> on_break {}

    in_consultation -> available {
      MUTATE : current_patient = NULL
    }

    in_surgery -> available {
      MUTATE : current_patient = NULL
    }

    on_break -> available {}

    available -> off_duty {}
  }
)


-- ============================================================================
-- MACHINE 3: Nurse
-- Cyclic machine — nurses rotate through shifts and assignments.
-- ============================================================================
DEFINE MACHINE Nurse (
  DATA {
    name            : TEXT -> REQUIRED
    department      : ENUM(emergency, icu, surgical, general, pediatrics) -> REQUIRED
    certification   : TEXT -> OPTIONAL
    current_patient : TEXT -> OPTIONAL
    patient_count   : INT -> DEFAULT(0)
  }

  STATES { off_duty, available, assigned, on_break }
  INITIAL STATE off_duty

  TRANSITIONS {
    off_duty -> available {}

    available -> assigned {
      GUARD : current_patient IS SET
    }

    assigned -> available {
      MUTATE : current_patient = NULL
    }

    available -> on_break {}

    on_break -> available {}

    available -> off_duty {}
  }
)


-- ============================================================================
-- MACHINE 4: Bed
-- Cyclic machine — beds rotate through occupancy and cleaning.
-- ============================================================================
DEFINE MACHINE Bed (
  DATA {
    ward        : ENUM(emergency, icu, surgical, general, pediatrics, maternity) -> REQUIRED
    room_number : TEXT -> REQUIRED
    bed_number  : TEXT -> REQUIRED
    bed_type    : ENUM(standard, icu, surgical, bariatric) -> DEFAULT(standard)
    occupant_id : TEXT -> OPTIONAL
  }

  STATES { available, reserved, occupied, cleaning, maintenance }
  INITIAL STATE available

  TRANSITIONS {
    available -> reserved {}

    reserved -> occupied {
      GUARD : occupant_id IS SET
    }

    occupied -> cleaning {
      MUTATE : occupant_id = NULL
      TIMEOUT : 2h -> available
    }

    cleaning -> available {}

    available -> maintenance {}

    maintenance -> available {}
  }
)


-- ============================================================================
-- MACHINE 5: EmergencyVisit
-- Full ER visit workflow with triage, examination, testing, and disposition.
-- ============================================================================
DEFINE MACHINE EmergencyVisit (
  DATA {
    patient_name    : TEXT -> REQUIRED
    patient_ref     : TEXT -> REQUIRED
    arrival_method  : ENUM(ambulance, walk_in, transfer) -> DEFAULT(walk_in)
    chief_complaint : TEXT -> REQUIRED
    blood_pressure  : TEXT -> OPTIONAL
    heart_rate      : INT -> OPTIONAL
    temperature     : TEXT -> OPTIONAL
    spo2            : INT -> OPTIONAL
    triage_level    : ENUM(immediate, emergent, urgent, less_urgent, non_urgent) -> OPTIONAL
    triage_nurse    : TEXT -> OPTIONAL
    attending_doctor: TEXT -> OPTIONAL
    diagnosis       : TEXT -> OPTIONAL
    disposition     : ENUM(admitted, discharged, transferred) -> OPTIONAL
    assigned_bed    : TEXT -> OPTIONAL
    notes           : TEXT -> OPTIONAL
  }

  STATES {
    arrived
    triage_assessment
    waiting
    in_examination
    undergoing_tests
    treatment
    observation
    admitted
    discharged
    transferred
  }
  INITIAL STATE arrived
  TERMINAL STATES { admitted, discharged, transferred }

  TRANSITIONS {
    arrived -> triage_assessment {
      GUARD : triage_nurse IS SET
    }

    triage_assessment -> waiting {}

    triage_assessment -> in_examination {
      GUARD : attending_doctor IS SET
    }

    waiting -> in_examination {
      GUARD : attending_doctor IS SET
      TIMEOUT : 4h -> discharged
    }

    in_examination -> undergoing_tests {}

    in_examination -> treatment {
      GUARD : diagnosis IS SET
    }

    undergoing_tests -> treatment {
      GUARD : diagnosis IS SET
    }

    treatment -> observation {
      TIMEOUT : 6h -> discharged
    }

    treatment -> discharged {}

    treatment -> admitted {
      GUARD : assigned_bed IS SET
    }

    observation -> discharged {}

    observation -> admitted {
      GUARD : assigned_bed IS SET
    }

    ANY -> transferred {
      EXCEPT FROM { discharged, admitted, transferred }
    }
  }

  HOOKS {
    ON SPAWN {
      EMIT("er.visit.arrived")
    }
    ON ENTER triage_assessment {
      EMIT("er.triage.started")
    }
  }
)


-- ============================================================================
-- MACHINE 6: Appointment
-- Scheduled outpatient visits with no-show handling.
-- ============================================================================
DEFINE MACHINE Appointment (
  DATA {
    patient_name  : TEXT -> REQUIRED
    patient_ref   : TEXT -> OPTIONAL
    doctor_name   : TEXT -> REQUIRED
    doctor_ref    : TEXT -> OPTIONAL
    appointment_type : ENUM(consultation, follow_up, annual_physical, pre_op, post_op) -> REQUIRED
    visit_notes   : TEXT -> OPTIONAL
    prescriptions : TEXT -> OPTIONAL
    lab_orders    : TEXT -> OPTIONAL
    follow_up     : TEXT -> OPTIONAL
  }

  STATES {
    scheduled
    confirmed
    checked_in
    in_consultation
    post_visit
    completed
    no_show
    cancelled
  }
  INITIAL STATE scheduled
  TERMINAL STATES { completed, no_show, cancelled }

  TRANSITIONS {
    scheduled -> confirmed {}

    scheduled -> cancelled {}

    confirmed -> checked_in {}

    confirmed -> no_show {
      TIMEOUT : 30m -> no_show
    }

    checked_in -> in_consultation {}

    in_consultation -> post_visit {
      GUARD : visit_notes IS SET
    }

    post_visit -> completed {}

    ANY -> cancelled {
      EXCEPT FROM { completed, no_show, cancelled, in_consultation, post_visit }
    }
  }
)


-- ============================================================================
-- MACHINE 7: LabOrder
-- Laboratory test lifecycle from ordering through results review.
-- ============================================================================
DEFINE MACHINE LabOrder (
  DATA {
    patient_name   : TEXT -> REQUIRED
    patient_ref    : TEXT -> OPTIONAL
    ordering_doctor: TEXT -> REQUIRED
    doctor_ref     : TEXT -> OPTIONAL
    test_type      : ENUM(cbc, cmp, troponin, cardiac_panel, lipid_panel, urinalysis, xray, ct_scan, mri, pre_op_panel) -> REQUIRED
    priority       : ENUM(routine, urgent, stat) -> DEFAULT(routine)
    specimen_type  : TEXT -> OPTIONAL
    results        : TEXT -> OPTIONAL
    result_flag    : ENUM(normal, abnormal, critical) -> OPTIONAL
    reviewed_by    : TEXT -> OPTIONAL
    notes          : TEXT -> OPTIONAL
  }

  STATES {
    ordered
    specimen_collected
    processing
    resulted
    reviewed
    cancelled
  }
  INITIAL STATE ordered
  TERMINAL STATES { reviewed, cancelled }

  TRANSITIONS {
    ordered -> specimen_collected {}

    ordered -> cancelled {}

    specimen_collected -> processing {
      TIMEOUT : 24h -> resulted
    }

    processing -> resulted {
      GUARD : results IS SET
    }

    resulted -> reviewed {
      GUARD : reviewed_by IS SET
    }

    ANY -> cancelled {
      EXCEPT FROM { resulted, reviewed, cancelled }
    }
  }
)


-- ============================================================================
-- MACHINE 8: Prescription
-- Medication lifecycle from prescribing through completion.
-- ============================================================================
DEFINE MACHINE Prescription (
  DATA {
    patient_name : TEXT -> REQUIRED
    patient_ref  : TEXT -> OPTIONAL
    doctor_name  : TEXT -> REQUIRED
    doctor_ref   : TEXT -> OPTIONAL
    medication   : TEXT -> REQUIRED
    dosage       : TEXT -> REQUIRED
    frequency    : TEXT -> REQUIRED
    route        : ENUM(oral, iv, im, subq, topical, inhaled) -> DEFAULT(oral)
    duration     : TEXT -> OPTIONAL
    dispensed_by : TEXT -> OPTIONAL
    notes        : TEXT -> OPTIONAL
  }

  STATES {
    prescribed
    verified
    dispensing
    dispensed
    active
    completed
    discontinued
  }
  INITIAL STATE prescribed
  TERMINAL STATES { completed, discontinued }

  TRANSITIONS {
    prescribed -> verified {}

    verified -> dispensing {}

    dispensing -> dispensed {
      GUARD : dispensed_by IS SET
    }

    dispensed -> active {}

    active -> completed {}

    ANY -> discontinued {
      EXCEPT FROM { completed, discontinued }
    }
  }
)


-- ============================================================================
-- MACHINE 9: Surgery
-- Full surgical workflow from request through post-op recovery.
-- ============================================================================
DEFINE MACHINE Surgery (
  DATA {
    patient_name      : TEXT -> REQUIRED
    patient_ref       : TEXT -> OPTIONAL
    surgeon_name      : TEXT -> REQUIRED
    surgeon_ref       : TEXT -> OPTIONAL
    procedure_name    : TEXT -> REQUIRED
    or_room           : TEXT -> OPTIONAL
    anesthesiologist  : TEXT -> OPTIONAL
    pre_op_notes      : TEXT -> OPTIONAL
    op_notes          : TEXT -> OPTIONAL
    post_op_notes     : TEXT -> OPTIONAL
    complications     : TEXT -> OPTIONAL
    estimated_duration: TEXT -> OPTIONAL
    blood_type_needed : TEXT -> OPTIONAL
  }

  STATES {
    requested
    pre_op_assessment
    pre_op_cleared
    scheduled_for_or
    in_holding
    under_anesthesia
    in_operation
    in_recovery_room
    post_op_ward
    surgery_completed
    surgery_cancelled
  }
  INITIAL STATE requested
  TERMINAL STATES { surgery_completed, surgery_cancelled }

  TRANSITIONS {
    requested -> pre_op_assessment {}

    pre_op_assessment -> pre_op_cleared {
      GUARD : pre_op_notes IS SET
    }

    pre_op_cleared -> scheduled_for_or {
      GUARD : or_room IS SET
      GUARD : anesthesiologist IS SET
    }

    scheduled_for_or -> in_holding {}

    in_holding -> under_anesthesia {}

    under_anesthesia -> in_operation {}

    in_operation -> in_recovery_room {
      GUARD : op_notes IS SET
    }

    in_recovery_room -> post_op_ward {
      TIMEOUT : 4h -> post_op_ward
    }

    post_op_ward -> surgery_completed {}

    ANY -> surgery_cancelled {
      EXCEPT FROM { in_operation, in_recovery_room, post_op_ward, surgery_completed, surgery_cancelled }
    }
  }

  HOOKS {
    ON ENTER in_operation {
      EMIT("surgery.started")
    }
    ON ENTER surgery_completed {
      EMIT("surgery.completed")
    }
  }
)


-- ============================================================================
-- MACHINE 10: BillingCase
-- Insurance billing workflow from charge capture through payment.
-- ============================================================================
DEFINE MACHINE BillingCase (
  DATA {
    patient_name      : TEXT -> REQUIRED
    patient_ref       : TEXT -> OPTIONAL
    insurance_provider: TEXT -> OPTIONAL
    insurance_id      : TEXT -> OPTIONAL
    total_charges     : INT -> OPTIONAL
    insurance_paid    : INT -> OPTIONAL
    patient_balance   : INT -> OPTIONAL
    coding_specialist : TEXT -> OPTIONAL
    claim_number      : TEXT -> OPTIONAL
    payment_method    : TEXT -> OPTIONAL
    notes             : TEXT -> OPTIONAL
  }

  STATES {
    charges_pending
    coded
    claim_submitted
    adjudicated
    patient_billed
    payment_received
    in_collections
    closed
    written_off
  }
  INITIAL STATE charges_pending
  TERMINAL STATES { closed, written_off }

  TRANSITIONS {
    charges_pending -> coded {
      GUARD : total_charges IS SET
    }

    coded -> claim_submitted {
      GUARD : insurance_provider IS SET
      GUARD : insurance_id IS SET
    }

    coded -> patient_billed {
      GUARD : patient_balance IS SET
    }

    claim_submitted -> adjudicated {
      TIMEOUT : 30d -> adjudicated
    }

    adjudicated -> patient_billed {
      GUARD : patient_balance IS SET
    }

    adjudicated -> closed {}

    patient_billed -> payment_received {}

    patient_billed -> in_collections {
      TIMEOUT : 90d -> in_collections
    }

    payment_received -> closed {}

    in_collections -> payment_received {}

    in_collections -> written_off {}
  }
)


-- ============================================================================
-- SCENARIO 1: Emergency Cardiac Event — Marcus Williams
-- ============================================================================
-- 58-year-old male arrives by ambulance with acute chest pain.
-- Triaged as emergent, cardiac workup reveals STEMI, emergency PCI
-- performed, 4-day recovery, discharged with cardiac medications.
-- ============================================================================

-- $1: Dr. Sarah Chen — Interventional Cardiologist
SPAWN Doctor { name: "Dr. Sarah Chen", specialty: cardiology, license_number: "MD-2019-44821" }

-- $2: Dr. James Rivera — Emergency Medicine
SPAWN Doctor { name: "Dr. James Rivera", specialty: emergency, license_number: "MD-2017-33156" }

-- $3: Nurse Grace Okonkwo — ER
SPAWN Nurse { name: "Grace Okonkwo", department: emergency, certification: "CEN" }

-- $4: Nurse David Kim — ICU
SPAWN Nurse { name: "David Kim", department: icu, certification: "CCRN" }

-- $5: ER Bed 101-A
SPAWN Bed { ward: emergency, room_number: "101", bed_number: "A", bed_type: standard }

-- $6: ICU Bed 204-A
SPAWN Bed { ward: icu, room_number: "204", bed_number: "A", bed_type: icu }

-- Activate staff
TRANSITION Doctor "$1" TO available
TRANSITION Doctor "$2" TO available
TRANSITION Nurse "$3" TO available
TRANSITION Nurse "$4" TO available

-- $7: Marcus Williams — Patient
SPAWN Patient {
  name: "Marcus Williams",
  date_of_birth: "1968-03-15",
  gender: male,
  blood_type: O_pos,
  insurance_id: "BCBS-MW-449821",
  allergies: "Penicillin",
  admission_type: emergency
}

-- $8: Marcus ER Visit
SPAWN EmergencyVisit {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  arrival_method: ambulance,
  chief_complaint: "Acute chest pain radiating to left arm, onset 45 minutes ago",
  blood_pressure: "168/95",
  heart_rate: 112,
  temperature: "98.6F",
  spo2: 94
}

-- Nurse Okonkwo triages Marcus
TRANSITION Nurse "$3" TO assigned WITH { current_patient: "Marcus Williams" }
TRANSITION EmergencyVisit "$8" TO triage_assessment WITH { triage_nurse: "Grace Okonkwo", triage_level: emergent }

-- Dr. Rivera examines Marcus
TRANSITION Doctor "$2" TO in_consultation WITH { current_patient: "Marcus Williams" }
TRANSITION EmergencyVisit "$8" TO in_examination WITH { attending_doctor: "Dr. James Rivera" }

-- Order cardiac labs
-- $9: Troponin test (STAT)
SPAWN LabOrder {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  ordering_doctor: "Dr. James Rivera",
  doctor_ref: "$2",
  test_type: troponin,
  priority: stat,
  specimen_type: "Blood"
}

-- $10: Full cardiac panel
SPAWN LabOrder {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  ordering_doctor: "Dr. James Rivera",
  doctor_ref: "$2",
  test_type: cardiac_panel,
  priority: stat,
  specimen_type: "Blood"
}

-- Process labs
TRANSITION LabOrder "$9" TO specimen_collected
TRANSITION LabOrder "$9" TO processing
TRANSITION LabOrder "$9" TO resulted WITH { results: "Troponin I: 4.2 ng/mL (CRITICAL HIGH)", result_flag: critical }
TRANSITION LabOrder "$10" TO specimen_collected
TRANSITION LabOrder "$10" TO processing
TRANSITION LabOrder "$10" TO resulted WITH { results: "CK-MB: 45 U/L (HIGH), BNP: 890 pg/mL (HIGH), D-dimer: 0.8 mg/L", result_flag: abnormal }

-- Dr. Rivera reviews troponin, confirms STEMI
TRANSITION LabOrder "$9" TO reviewed WITH { reviewed_by: "Dr. James Rivera" }
TRANSITION LabOrder "$10" TO reviewed WITH { reviewed_by: "Dr. James Rivera" }

-- ER visit moves to tests then treatment
TRANSITION EmergencyVisit "$8" TO undergoing_tests
TRANSITION EmergencyVisit "$8" TO treatment WITH { diagnosis: "ST-Elevation Myocardial Infarction (STEMI)" }

-- Assign nurse, update patient with diagnosis and admit
TRANSITION Patient "$7" TO triaged WITH { assigned_nurse: "Grace Okonkwo" }
TRANSITION Bed "$6" TO reserved
TRANSITION Bed "$6" TO occupied WITH { occupant_id: "$7" }
TRANSITION Patient "$7" TO admitted WITH { assigned_doctor: "Dr. Sarah Chen", assigned_bed: "ICU-204-A", primary_diagnosis: "STEMI - Acute Myocardial Infarction" }

-- ER visit disposition: admitted
TRANSITION EmergencyVisit "$8" TO admitted WITH { assigned_bed: "ICU-204-A", disposition: admitted }

-- Nurse Okonkwo returns to available, Dr. Rivera done
TRANSITION Nurse "$3" TO available
TRANSITION Doctor "$2" TO available

-- $11: Emergency PCI Surgery
SPAWN Surgery {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  surgeon_name: "Dr. Sarah Chen",
  surgeon_ref: "$1",
  procedure_name: "Percutaneous Coronary Intervention (PCI) with stent placement",
  estimated_duration: "90 minutes",
  blood_type_needed: "O+"
}

-- Dr. Chen enters surgery
TRANSITION Doctor "$1" TO in_surgery WITH { current_patient: "Marcus Williams" }

-- Surgery workflow: pre-op → cleared → scheduled → holding → anesthesia → operation → recovery
TRANSITION Surgery "$11" TO pre_op_assessment
TRANSITION Surgery "$11" TO pre_op_cleared WITH { pre_op_notes: "ECG confirms STEMI in leads II, III, aVF. Patient consented. NPO confirmed. IV access established." }
TRANSITION Surgery "$11" TO scheduled_for_or WITH { or_room: "Cath Lab 2", anesthesiologist: "Dr. Linda Park" }
TRANSITION Surgery "$11" TO in_holding
TRANSITION Surgery "$11" TO under_anesthesia
TRANSITION Surgery "$11" TO in_operation
TRANSITION Patient "$7" TO in_treatment
TRANSITION Patient "$7" TO in_surgery
TRANSITION Surgery "$11" TO in_recovery_room WITH { op_notes: "Successful PCI with drug-eluting stent to LAD. Door-to-balloon: 58 min. Good distal flow restored. No complications." }
TRANSITION Surgery "$11" TO post_op_ward WITH { post_op_notes: "Patient stable. Transferred to ICU for monitoring. Vitals within normal limits." }
TRANSITION Surgery "$11" TO surgery_completed

-- Dr. Chen finishes
TRANSITION Doctor "$1" TO available

-- Nurse Kim assigned for ICU recovery
TRANSITION Nurse "$4" TO assigned WITH { current_patient: "Marcus Williams" }

-- Patient recovers
TRANSITION Patient "$7" TO recovering WITH { notes: "Post-PCI day 1: Hemodynamically stable, stent placement successful" }

-- Prescribe cardiac medications
-- $12: Aspirin
SPAWN Prescription {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  doctor_name: "Dr. Sarah Chen",
  doctor_ref: "$1",
  medication: "Aspirin",
  dosage: "81mg",
  frequency: "Once daily",
  route: oral,
  duration: "Indefinite"
}

-- $13: Ticagrelor
SPAWN Prescription {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  doctor_name: "Dr. Sarah Chen",
  doctor_ref: "$1",
  medication: "Ticagrelor",
  dosage: "90mg",
  frequency: "Twice daily",
  route: oral,
  duration: "12 months"
}

-- $14: Atorvastatin
SPAWN Prescription {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  doctor_name: "Dr. Sarah Chen",
  doctor_ref: "$1",
  medication: "Atorvastatin",
  dosage: "80mg",
  frequency: "Once daily at bedtime",
  route: oral,
  duration: "Indefinite"
}

-- $15: Metoprolol
SPAWN Prescription {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  doctor_name: "Dr. Sarah Chen",
  doctor_ref: "$1",
  medication: "Metoprolol Succinate",
  dosage: "25mg",
  frequency: "Once daily",
  route: oral,
  duration: "Indefinite"
}

-- Process all prescriptions through dispensing
TRANSITION Prescription "$12" TO verified
TRANSITION Prescription "$12" TO dispensing
TRANSITION Prescription "$12" TO dispensed WITH { dispensed_by: "PharmTech Rodriguez" }
TRANSITION Prescription "$12" TO active

TRANSITION Prescription "$13" TO verified
TRANSITION Prescription "$13" TO dispensing
TRANSITION Prescription "$13" TO dispensed WITH { dispensed_by: "PharmTech Rodriguez" }
TRANSITION Prescription "$13" TO active

TRANSITION Prescription "$14" TO verified
TRANSITION Prescription "$14" TO dispensing
TRANSITION Prescription "$14" TO dispensed WITH { dispensed_by: "PharmTech Rodriguez" }
TRANSITION Prescription "$14" TO active

TRANSITION Prescription "$15" TO verified
TRANSITION Prescription "$15" TO dispensing
TRANSITION Prescription "$15" TO dispensed WITH { dispensed_by: "PharmTech Rodriguez" }
TRANSITION Prescription "$15" TO active

-- Patient ready for discharge after 4-day recovery
TRANSITION Patient "$7" TO ready_for_discharge WITH { notes: "Post-PCI day 4: Stable, ambulating, tolerating diet. Discharge with cardiac rehab referral." }
TRANSITION Patient "$7" TO discharged

-- Clean up: nurse done, bed cleaning
TRANSITION Nurse "$4" TO available
TRANSITION Bed "$6" TO cleaning

-- $16: Marcus billing
SPAWN BillingCase {
  patient_name: "Marcus Williams",
  patient_ref: "$7",
  insurance_provider: "Blue Cross Blue Shield",
  insurance_id: "BCBS-MW-449821",
  total_charges: 87500,
  notes: "Emergency PCI with stent, 4-day ICU stay, cardiac medications"
}

TRANSITION BillingCase "$16" TO coded WITH { coding_specialist: "Jennifer Adams", total_charges: 87500 }
TRANSITION BillingCase "$16" TO claim_submitted WITH { claim_number: "CLM-2024-88921" }
TRANSITION BillingCase "$16" TO adjudicated WITH { insurance_paid: 72000, patient_balance: 15500 }
TRANSITION BillingCase "$16" TO patient_billed WITH { patient_balance: 15500 }


-- ============================================================================
-- SCENARIO 2: Routine Annual Physical — Elena Vasquez
-- ============================================================================
-- 42-year-old female scheduled for annual physical. Labs ordered,
-- elevated cholesterol discovered, statin prescribed, follow-up scheduled.
-- ============================================================================

-- $17: Elena Vasquez — Patient
SPAWN Patient {
  name: "Elena Vasquez",
  date_of_birth: "1984-07-22",
  gender: female,
  blood_type: A_pos,
  insurance_id: "AETNA-EV-221847",
  admission_type: outpatient
}

-- $18: Dr. Michael Thompson — General Practice
SPAWN Doctor { name: "Dr. Michael Thompson", specialty: general, license_number: "MD-2012-19834" }
TRANSITION Doctor "$18" TO available

-- $19: Elena's annual physical appointment
SPAWN Appointment {
  patient_name: "Elena Vasquez",
  patient_ref: "$17",
  doctor_name: "Dr. Michael Thompson",
  doctor_ref: "$18",
  appointment_type: annual_physical
}

-- Appointment workflow: confirm → check-in → consultation
TRANSITION Appointment "$19" TO confirmed
TRANSITION Appointment "$19" TO checked_in
TRANSITION Doctor "$18" TO in_consultation WITH { current_patient: "Elena Vasquez" }
TRANSITION Appointment "$19" TO in_consultation

-- Order labs during visit
-- $20: Comprehensive Metabolic Panel
SPAWN LabOrder {
  patient_name: "Elena Vasquez",
  patient_ref: "$17",
  ordering_doctor: "Dr. Michael Thompson",
  doctor_ref: "$18",
  test_type: cmp,
  priority: routine,
  specimen_type: "Blood"
}

-- $21: Urinalysis
SPAWN LabOrder {
  patient_name: "Elena Vasquez",
  patient_ref: "$17",
