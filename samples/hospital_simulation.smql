-- Demonstrates follow-up appointment workflow.
-- ============================================================================

-- $94: Post-op follow-up appointment
SPAWN Appointment {
  patient_name: "Robert Nakamura",
  patient_ref: "$27",
  doctor_name: "Dr. Patricia Morrison",
  doctor_ref: "$24",
  appointment_type: post_op
}

TRANSITION Appointment "$94" TO confirmed
TRANSITION Appointment "$94" TO checked_in
TRANSITION Doctor "$24" TO in_consultation WITH { current_patient: "Robert Nakamura" }
TRANSITION Appointment "$94" TO in_consultation

-- $95: Post-op blood work
SPAWN LabOrder {
  patient_name: "Robert Nakamura",
  patient_ref: "$27",
  ordering_doctor: "Dr. Patricia Morrison",
  doctor_ref: "$24",
  test_type: cbc,
  priority: routine,
  specimen_type: "Blood",
  notes: "6-week post-op CBC, CRP, ESR"
}

TRANSITION LabOrder "$95" TO specimen_collected
TRANSITION LabOrder "$95" TO processing
TRANSITION LabOrder "$95" TO resulted WITH { results: "WBC: 7.1, Hgb: 13.8, Plt: 256, CRP: 3.2 (mildly elevated), ESR: 18. All trending to normal.", result_flag: normal }
TRANSITION LabOrder "$95" TO reviewed WITH { reviewed_by: "Dr. Patricia Morrison" }

TRANSITION Appointment "$94" TO post_visit WITH { visit_notes: "6-week post-op: Incision healed well, no signs of infection. ROM improving (flexion 95 degrees). CRP mildly elevated but trending down. PT progress excellent. Continue home exercises. Return in 3 months.", follow_up: "3 months - final post-op check" }
TRANSITION Appointment "$94" TO completed
TRANSITION Doctor "$24" TO available


-- ============================================================================
-- SCENARIO 14: Observation → Admission — Linda Park
-- ============================================================================
-- 60-year-old female with atypical chest pain. ER observation protocol
-- with serial troponins. First troponin negative, second slightly
-- elevated — admitted for cardiac catheterization. Demonstrates the
-- observation-to-admission pathway.
-- ============================================================================

-- $96: Linda Park — Patient
SPAWN Patient {
  name: "Linda Park",
  date_of_birth: "1966-10-15",
  gender: female,
  blood_type: A_pos,
  insurance_id: "HUMANA-LP-889234",
  allergies: "Codeine",
  admission_type: emergency
}

-- $97: Linda ER Visit
SPAWN EmergencyVisit {
  patient_name: "Linda Park",
  patient_ref: "$96",
  arrival_method: walk_in,
  chief_complaint: "Atypical chest pressure with exertion, nausea, jaw pain. Onset during gardening 2 hours ago.",
  blood_pressure: "155/92",
  heart_rate: 84,
  temperature: "98.2F",
  spo2: 97
}

TRANSITION EmergencyVisit "$97" TO triage_assessment WITH { triage_nurse: "Grace Okonkwo", triage_level: emergent }
TRANSITION EmergencyVisit "$97" TO in_examination WITH { attending_doctor: "Dr. James Rivera" }
TRANSITION Doctor "$2" TO in_consultation WITH { current_patient: "Linda Park" }

-- $98: Serial troponin #1
SPAWN LabOrder {
  patient_name: "Linda Park",
  patient_ref: "$96",
  ordering_doctor: "Dr. James Rivera",
  doctor_ref: "$2",
  test_type: troponin,
  priority: stat,
  specimen_type: "Blood",
  notes: "Serial troponin #1 - chest pain rule-out"
}

-- $99: Cardiac panel
SPAWN LabOrder {
  patient_name: "Linda Park",
  patient_ref: "$96",
  ordering_doctor: "Dr. James Rivera",
  doctor_ref: "$2",
  test_type: cardiac_panel,
  priority: stat,
  specimen_type: "Blood",
  notes: "ECG + cardiac markers"
}

-- First troponin negative
TRANSITION LabOrder "$98" TO specimen_collected
TRANSITION LabOrder "$98" TO processing
TRANSITION LabOrder "$98" TO resulted WITH { results: "Troponin I: 0.03 ng/mL (normal <0.04). Baseline troponin within normal limits.", result_flag: normal }
TRANSITION LabOrder "$98" TO reviewed WITH { reviewed_by: "Dr. James Rivera" }

TRANSITION LabOrder "$99" TO specimen_collected
TRANSITION LabOrder "$99" TO processing
TRANSITION LabOrder "$99" TO resulted WITH { results: "BNP: 180 (BORDERLINE), ECG: NSR rate 84, non-specific ST-T changes in V4-V6", result_flag: abnormal }
TRANSITION LabOrder "$99" TO reviewed WITH { reviewed_by: "Dr. James Rivera" }

-- Move to observation for serial troponins
TRANSITION EmergencyVisit "$97" TO undergoing_tests
TRANSITION EmergencyVisit "$97" TO treatment WITH { diagnosis: "Chest pain, rule out ACS. Non-specific ECG changes. Observation protocol initiated." }
TRANSITION EmergencyVisit "$97" TO observation

-- Second troponin (4h later) comes back elevated — admit
-- $100: Observation bed
SPAWN Bed { ward: general, room_number: "310", bed_number: "B", bed_type: standard }
TRANSITION Bed "$100" TO reserved
TRANSITION Bed "$100" TO occupied WITH { occupant_id: "$96" }

TRANSITION EmergencyVisit "$97" TO admitted WITH { assigned_bed: "GEN-310-B", disposition: admitted, notes: "Repeat troponin 0.12 (ELEVATED). Admitting for cardiac catheterization." }
TRANSITION Doctor "$2" TO available

TRANSITION Patient "$96" TO triaged WITH { assigned_nurse: "Grace Okonkwo" }
TRANSITION Patient "$96" TO admitted WITH { assigned_doctor: "Dr. Sarah Chen", assigned_bed: "GEN-310-B", primary_diagnosis: "NSTEMI - Non-ST Elevation Myocardial Infarction" }
TRANSITION Patient "$96" TO in_treatment

-- $101: Linda billing
SPAWN BillingCase {
  patient_name: "Linda Park",
  patient_ref: "$96",
  insurance_provider: "Humana",
  insurance_id: "HUMANA-LP-889234",
  total_charges: 32000,
  notes: "ER observation, serial troponins, cardiac markers, admission for cath"
}

TRANSITION BillingCase "$101" TO coded WITH { coding_specialist: "Michael Park", total_charges: 32000 }
TRANSITION BillingCase "$101" TO claim_submitted WITH { claim_number: "CLM-2024-89700" }


-- ============================================================================
-- SCENARIO 15: Inter-Facility Transfer — Samuel Okafor
-- ============================================================================
-- 50-year-old male transferred from rural clinic with suspected aortic
-- dissection. Stabilized in ER, transferred to cardiac surgery center.
-- Demonstrates the transfer disposition pathway.
-- ============================================================================

-- $102: Samuel Okafor — Patient
SPAWN Patient {
  name: "Samuel Okafor",
  date_of_birth: "1976-07-19",
  gender: male,
  blood_type: AB_neg,
  insurance_id: "BCBS-SO-223891",
  allergies: "ACE inhibitors",
  admission_type: emergency
}

-- $103: Samuel ER Visit
SPAWN EmergencyVisit {
  patient_name: "Samuel Okafor",
  patient_ref: "$102",
  arrival_method: transfer,
  chief_complaint: "Transfer from rural clinic: tearing chest pain radiating to back, BP differential between arms, widened mediastinum on portable CXR",
  blood_pressure: "178/95",
  heart_rate: 108,
  temperature: "98.0F",
  spo2: 94
}

TRANSITION EmergencyVisit "$103" TO triage_assessment WITH { triage_nurse: "Sarah Williams", triage_level: immediate }
TRANSITION EmergencyVisit "$103" TO in_examination WITH { attending_doctor: "Dr. James Rivera" }
TRANSITION Doctor "$2" TO in_consultation WITH { current_patient: "Samuel Okafor" }

-- $104: CT Aorta
SPAWN LabOrder {
  patient_name: "Samuel Okafor",
  patient_ref: "$102",
  ordering_doctor: "Dr. James Rivera",
  doctor_ref: "$2",
  test_type: ct_scan,
  priority: stat,
  specimen_type: "Imaging",
  notes: "CT Angiogram Aorta - rule out dissection"
}

TRANSITION LabOrder "$104" TO specimen_collected
TRANSITION LabOrder "$104" TO processing
TRANSITION LabOrder "$104" TO resulted WITH { results: "Stanford Type A aortic dissection. Intimal flap from aortic root to descending aorta. Pericardial effusion present. No malperfusion syndrome currently.", result_flag: critical }
TRANSITION LabOrder "$104" TO reviewed WITH { reviewed_by: "Dr. James Rivera" }

TRANSITION EmergencyVisit "$103" TO undergoing_tests
TRANSITION EmergencyVisit "$103" TO treatment WITH { diagnosis: "Stanford Type A Aortic Dissection - requires emergent cardiothoracic surgery" }

-- $105: Esmolol drip (HR/BP control)
SPAWN Prescription {
  patient_name: "Samuel Okafor",
  patient_ref: "$102",
  doctor_name: "Dr. James Rivera",
  doctor_ref: "$2",
  medication: "Esmolol",
  dosage: "50-200 mcg/kg/min",
  frequency: "Continuous IV infusion, titrate to HR <60 and SBP <120",
  route: iv,
  duration: "Until transfer"
}

TRANSITION Prescription "$105" TO verified
TRANSITION Prescription "$105" TO dispensing
TRANSITION Prescription "$105" TO dispensed WITH { dispensed_by: "PharmTech Kim" }
TRANSITION Prescription "$105" TO active

-- Transfer to cardiac surgery center (this facility cannot do aortic surgery)
TRANSITION EmergencyVisit "$103" TO transferred WITH { notes: "Transferred to University Medical Center for emergent Type A dissection repair. Esmolol infusion running. HR 58, BP 118/72 at time of transfer." }
TRANSITION Doctor "$2" TO available

TRANSITION Patient "$102" TO triaged WITH { assigned_nurse: "Sarah Williams", primary_diagnosis: "Stanford Type A Aortic Dissection" }

-- $106: Samuel billing (ER stabilization only)
SPAWN BillingCase {
  patient_name: "Samuel Okafor",
  patient_ref: "$102",
  insurance_provider: "Blue Cross Blue Shield",
  insurance_id: "BCBS-SO-223891",
  total_charges: 18500,
  notes: "ER stabilization, CT angiogram, esmolol drip, transfer to cardiac surgery center"
}

TRANSITION BillingCase "$106" TO coded WITH { coding_specialist: "Michael Park", total_charges: 18500 }
TRANSITION BillingCase "$106" TO claim_submitted WITH { claim_number: "CLM-2024-89750" }
TRANSITION BillingCase "$106" TO adjudicated WITH { insurance_paid: 16000, patient_balance: 2500 }
TRANSITION BillingCase "$106" TO patient_billed WITH { patient_balance: 2500 }


-- ============================================================================
-- Set staff back to reasonable end-of-day states
-- ============================================================================
TRANSITION Doctor "$1" TO off_duty
TRANSITION Doctor "$2" TO off_duty
TRANSITION Doctor "$18" TO off_duty
TRANSITION Doctor "$24" TO off_duty
TRANSITION Nurse "$3" TO off_duty
TRANSITION Nurse "$4" TO available
TRANSITION Nurse "$4" TO off_duty
TRANSITION Nurse "$25" TO off_duty
TRANSITION Nurse "$76" TO off_duty


-- ============================================================================
-- ANALYTICS QUERIES
-- ============================================================================

-- === Census: Hospital-wide state distribution ===
AGGREGATE Patient GROUP BY STATE
AGGREGATE Bed GROUP BY STATE
AGGREGATE Doctor GROUP BY STATE
AGGREGATE Nurse GROUP BY STATE

-- === Clinical: Active orders and procedures ===
AGGREGATE LabOrder GROUP BY STATE
AGGREGATE Prescription GROUP BY STATE
AGGREGATE Surgery GROUP BY STATE
AGGREGATE Appointment GROUP BY STATE
AGGREGATE EmergencyVisit GROUP BY STATE
AGGREGATE BillingCase GROUP BY STATE

-- === Funnels: Lifecycle conversion tracking ===
FUNNEL Patient THROUGH [registered, triaged, admitted, in_treatment, recovering, ready_for_discharge, discharged]
FUNNEL EmergencyVisit THROUGH [arrived, triage_assessment, in_examination, undergoing_tests, treatment, discharged]
FUNNEL EmergencyVisit THROUGH [arrived, triage_assessment, in_examination, undergoing_tests, treatment, observation, discharged]
FUNNEL EmergencyVisit THROUGH [arrived, triage_assessment, in_examination, undergoing_tests, treatment, admitted]
FUNNEL Appointment THROUGH [scheduled, confirmed, checked_in, in_consultation, post_visit, completed]
FUNNEL Surgery THROUGH [requested, pre_op_assessment, pre_op_cleared, scheduled_for_or, in_operation, in_recovery_room, surgery_completed]
FUNNEL LabOrder THROUGH [ordered, specimen_collected, processing, resulted, reviewed]
FUNNEL Prescription THROUGH [prescribed, verified, dispensing, dispensed, active, completed]
FUNNEL BillingCase THROUGH [charges_pending, coded, claim_submitted, adjudicated, patient_billed, payment_received, closed]

-- === Path Analysis: Common routes through machines ===
PATHS FROM Patient
PATHS FROM EmergencyVisit
PATHS FROM Surgery
PATHS FROM Appointment
PATHS FROM BillingCase
PATHS FROM Prescription

-- === Segmented Path Analysis ===
COMPARE PATHS EmergencyVisit SEGMENT BY triage_level
COMPARE PATHS EmergencyVisit SEGMENT BY arrival_method
COMPARE PATHS Patient SEGMENT BY admission_type
COMPARE PATHS BillingCase SEGMENT BY insurance_provider

-- === Find: Specific state queries ===
FIND Patient WHERE STATE IS discharged
FIND Patient WHERE STATE IS admitted
FIND Patient WHERE STATE IS in_treatment
FIND Patient WHERE STATE IS registered
FIND Bed WHERE STATE IS available
FIND Bed WHERE STATE IS occupied
FIND Bed WHERE STATE IS cleaning
FIND LabOrder WHERE STATE IS reviewed
FIND Prescription WHERE STATE IS active
FIND Prescription WHERE STATE IS discontinued
FIND BillingCase WHERE STATE IS closed
FIND BillingCase WHERE STATE IS written_off
FIND BillingCase WHERE STATE IS claim_submitted
FIND BillingCase WHERE STATE IS patient_billed
FIND Appointment WHERE STATE IS no_show
FIND Appointment WHERE STATE IS completed
FIND Surgery WHERE STATE IS surgery_completed
FIND Surgery WHERE STATE IS surgery_cancelled
FIND EmergencyVisit WHERE STATE IS admitted
FIND EmergencyVisit WHERE STATE IS discharged
FIND EmergencyVisit WHERE STATE IS transferred

