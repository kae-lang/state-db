-- SMQL Engine Performance Benchmark
-- Measures: spawn throughput, transition throughput, query throughput
-- Target: 1000 instances with multiple transitions each

DEFINE MACHINE BenchItem (
  DATA {
    label    : TEXT -> REQUIRED
    counter  : INT  -> DEFAULT(0)
    category : ENUM(alpha, beta, gamma, delta) -> DEFAULT(alpha)
  }

  STATES { created, processing, review, approved, completed, rejected }
  INITIAL STATE created
  TERMINAL STATES { completed, rejected }

  TRANSITIONS {
    created -> processing {
      GUARD : label IS SET
    }
    processing -> review {
      MUTATE : counter = counter + 1
    }
    review -> approved {}
    review -> rejected {}
    approved -> completed {}
    ANY -> rejected {
      EXCEPT FROM { completed, rejected }
    }
  }
)

-- ============================================================================
-- PHASE 1: SPAWN 1000 instances (measures spawn throughput)
-- ============================================================================

SPAWN BenchItem { label: "item-001", category: alpha }
SPAWN BenchItem { label: "item-002", category: beta }
SPAWN BenchItem { label: "item-003", category: gamma }
SPAWN BenchItem { label: "item-004", category: delta }
SPAWN BenchItem { label: "item-005", category: alpha }
SPAWN BenchItem { label: "item-006", category: beta }
SPAWN BenchItem { label: "item-007", category: gamma }
